NODE_ENV=development
PORT=4015

# Same MongoDB cluster as API gateway / other ExtraHand services (no new database)
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB=extrahand

SERVICE_AUTH_TOKEN=replace-with-a-strong-random-token

# Used for first-booking eligibility checks
PAYMENT_SERVICE_URL=http://localhost:4009

# Catalog content admin proxy target for coupon-portal admin sessions
TASK_SERVICE_URL=http://localhost:4002

# Optional (32+ chars): signs coupon-portal admin session tokens. Derived from SERVICE_AUTH_TOKEN when unset.
# ADMIN_SESSION_SECRET=

# Optional fallback admin, used only when payment-service login is unreachable (no default).
# LOCAL_ADMIN_USERNAME=
# LOCAL_ADMIN_PASSWORD=

# Pending redemption TTL (minutes)
PENDING_REDEMPTION_TTL_MINUTES=30

LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:5000
